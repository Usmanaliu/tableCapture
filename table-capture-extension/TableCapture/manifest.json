{
    "manifest_version": 3,

    "name": "Table Capture",

    "version": "1.0.0",

    "description": "Capture complete HTML tables across pagination.",

    "permissions": [
        "storage",
        "tabs"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}